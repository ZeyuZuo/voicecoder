{
  "name": "voicecoder-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "schema:codex-app-server": "node scripts/generate-codex-app-server-schema.mjs",
    "diagnose:iflytek": "node scripts/diagnose-iflytek-handshake.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test dist-tests/requirementState.test.mjs dist-tests/demoSession.test.mjs dist-tests/agentProgress.test.mjs dist-tests/DemoProgressPanel.test.mjs",
    "pretest:unit": "esbuild src/utils/requirementState.test.ts src/utils/demoSession.test.ts src/utils/agentProgress.test.ts src/components/DemoProgressPanel.test.tsx --bundle --platform=node --format=esm --packages=external --outdir=dist-tests --out-extension:.js=.mjs --entry-names=[name]",
    "check:rust": "cd src-tauri && cargo fmt -- --check && cargo check && cargo test",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run check:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
